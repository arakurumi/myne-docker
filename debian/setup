#!/bin/bash

github_latest() {
    local repo="$1"
    local pattern="$2"
    curl -s "https://api.github.com/repos/$repo/releases/latest" | grep browser_download_url | grep "$pattern" | head -1 | sed 's/.*"browser_download_url": "\(.*\)"/\1/'
}

apt update --yes
apt upgrade --yes

# Main Packages
apt install --yes --no-install-recommends \
    apt-utils aria2 ca-certificates coreutils curl fastfetch git locales mediainfo qbittorrent-nox sox tzdata wget

# Build Packages
apt install --yes --no-install-recommends \
    autoconf automake build-essential cmake g++ gcc gettext gpg-agent intltool libcurl4-openssl-dev libmagic-dev libssl-dev make p7zip-full unzip zip zlib1g-dev

# Python Packages
apt install --yes --no-install-recommends \
    python-is-python3 python3-dev python3-pip
python -m pip install --break-system-packages --upgrade pip

mkdir /temp

locale-gen en_US.UTF-8
update-locale LANG=en_US.UTF-8
dpkg-reconfigure --frontend=noninteractive locales

ln -fs /usr/share/zoneinfo/Asia/Jakarta /etc/localtime
dpkg-reconfigure --frontend=noninteractive tzdata

# 7Zip
cd /temp
url_latest=$(curl -s https://7-zip.org/ | grep -o '7z[0-9]*\-linux-x64\.tar\.xz' | head -1)
wget "https://7-zip.org/a/$url_latest"
7z x -o7z -y "$url_latest"
cd /temp/7z
7z x -y "${url_latest%.tar.xz}.tar"
mv 7zzs /usr/bin/7z
chmod +x /usr/bin/7z

# Bun
cd /temp
curl -fsSL https://bun.sh/install | bash

# Bento4
cd /temp
mkdir bento4
cd /temp/bento4
git clone -c advice.detachedHead=false https://github.com/axiomatic-systems/Bento4.git .
cmake -DCMAKE_BUILD_TYPE=Release .
make -j$(nproc)
make install

# CCExtractor
cd /temp
url=$(github_latest "CCExtractor/ccextractor" "ccextractor-hardsubx.*debian13.*\\.deb")
wget "$url"
apt install --yes --no-install-recommends \
    ./"$(basename "$url")"

# Code-Server
cd /temp
curl -fsSL https://code-server.dev/install.sh | sh

# Dovi-Tool
cd /temp
url=$(github_latest "quietvoid/dovi_tool" "x86_64-unknown-linux-musl\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv dovi_tool /usr/bin/dovi_tool
chmod +x /usr/bin/dovi_tool

# FFMPEG
cd /temp
url=$(github_latest "arakurumi/FFmpeg-Builds" "linux64-nonfree.*\\.tar\\.xz")
wget "$url"
filename=$(basename "$url")
tar -xJf "$filename"
cd /temp/ffmpeg-*/bin
mv ffmpeg /usr/bin/ffmpeg
mv ffprobe /usr/bin/ffprobe
mv ffplay /usr/bin/ffplay
chmod +x /usr/bin/ffmpeg
chmod +x /usr/bin/ffprobe
chmod +x /usr/bin/ffplay

# Gost
cd /temp
url=$(github_latest "ginuerzh/gost" "linux_amd64v3\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv gost /usr/bin/gost
chmod +x /usr/bin/gost

# GPAC
cd /temp
mkdir gpac
cd /temp/gpac
git clone -c advice.detachedHead=false https://github.com/gpac/gpac.git .
./configure --static-bin
make -j$(nproc)
make install

# HDR10Plus-Tool
cd /temp
url=$(github_latest "quietvoid/hdr10plus_tool" "x86_64-unknown-linux-musl\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv hdr10plus_tool /usr/bin/hdr10plus_tool
chmod +x /usr/bin/hdr10plus_tool

# MKVToolNix
cd /temp
wget -O /usr/share/keyrings/gpg-pub-moritzbunkus.gpg https://mkvtoolnix.download/gpg-pub-moritzbunkus.gpg
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/gpg-pub-moritzbunkus.gpg] https://mkvtoolnix.download/debian/ trixie main" >>/etc/apt/sources.list.d/mkvtoolnix.download.list
echo "deb-src [arch=amd64 signed-by=/usr/share/keyrings/gpg-pub-moritzbunkus.gpg] https://mkvtoolnix.download/debian/ trixie main" >>/etc/apt/sources.list.d/mkvtoolnix.download.list
apt update --yes
apt install --yes --no-install-recommends mkvtoolnix

# N-M3U8DL-Re
cd /temp
url=$(github_latest "nilaoda/N_m3u8DL-RE" "linux-x64.*\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv N_m3u8DL-RE /usr/bin/m3u8
chmod +x /usr/bin/m3u8

# Rclone
cd /temp
curl https://rclone.org/install.sh | bash

# Shaka-Packager
cd /temp
wget https://github.com/shaka-project/shaka-packager/releases/download/v2.6.1/packager-linux-x64
mv packager-linux-x64 /usr/bin/shaka-packager
chmod +x /usr/bin/shaka-packager

# Usque
cd /temp
url=$(github_latest "Diniboy1123/usque" "linux_amd64\\.zip")
wget "$url"
filename=$(basename "$url")
7z x -y "$filename"
mv usque /usr/bin/usque
chmod +x /usr/bin/usque

cd /
rm -rf /temp

apt remove --yes \
    autoconf automake build-essential cmake g++ gcc gettext gpg-agent intltool libcurl4-openssl-dev libmagic-dev libssl-dev make p7zip-full unzip zip zlib1g-dev

apt autoclean --yes
apt autoremove --yes
apt clean

rm -rf /root/.cache
rm -rf /tmp/*
rm -rf /var/lib/apt/lists/*
rm -rf Dockerfile
rm -rf setup
