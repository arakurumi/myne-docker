#!/bin/sh

github_latest() {
    repo="$1"
    pattern="$2"
    curl -s "https://api.github.com/repos/$repo/releases/latest" | grep browser_download_url | grep "$pattern" | head -1 | sed 's/.*"browser_download_url": "\(.*\)"/\1/'
}

apk update
apk upgrade

# Main Packages
apk add --no-cache \
    aria2 coreutils curl fastfetch ffmpeg file git mediainfo mkvtoolnix nodejs npm openjdk25-jre sox tzdata wget

# Build Packages
apk add --no-cache \
    autoconf automake bash boost-dev ccache clang18-dev cmake curl-dev dpkg g++ gawk gcc gettext-dev jq libtool linux-headers make musl-dev musl-locales nodejs pv unzip xz zip zlib-dev

# Python Packages
apk add --no-cache py3-pip python3-dev
python -m pip install --break-system-packages --upgrade pip

mkdir /temp

echo "Asia/Jakarta" >>/etc/timezone
cp /usr/share/zoneinfo/Asia/Jakarta /etc/localtime

# 7Zip
cd /temp
url=$(curl -sL https://7-zip.org/download.html | grep -o 'https://github.com[^"]*linux-x64\.tar\.xz' | head -1)
wget "$url"
filename=$(basename "$url")
mkdir -p 7z
xz -dc "$filename" | tar -xf - -C 7z
cd /temp/7z
mv 7zzs /usr/bin/7z
chmod +x /usr/bin/7z

# Bun
cd /temp
curl -fsSL https://bun.sh/install | bash

# Bento4
cd /temp
mkdir bento4
cd /temp/bento4
git clone -c advice.detachedHead=false https://github.com/axiomatic-systems/Bento4.git .
cmake -DCMAKE_BUILD_TYPE=Release .
make -j$(nproc)
make install

# Code-Server
cd /temp
curl -fsSL https://code-server.dev/install.sh | sh

# Dovi-Tool
cd /temp
url=$(github_latest "quietvoid/dovi_tool" "x86_64-unknown-linux-musl\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv dovi_tool /usr/bin/dovi_tool
chmod +x /usr/bin/dovi_tool

# Gost
cd /temp
url=$(github_latest "ginuerzh/gost" "linux_amd64v3\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv gost /usr/bin/gost
chmod +x /usr/bin/gost

# GPAC
cd /temp
mkdir gpac
cd /temp/gpac
git clone -c advice.detachedHead=false https://github.com/gpac/gpac.git .
./configure --static-bin
make -j$(nproc)
make install

# HDR10Plus-Tool
cd /temp
url=$(github_latest "quietvoid/hdr10plus_tool" "x86_64-unknown-linux-musl\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv hdr10plus_tool /usr/bin/hdr10plus_tool
chmod +x /usr/bin/hdr10plus_tool

# CCExtractor
cd /temp
wget https://github.com/CCExtractor/ccextractor/releases/latest/download/ccextractor-linux-systemlibs-hardsubx-x86_64.tar.gz
7z x -y ccextractor-linux-systemlibs-hardsubx-x86_64.tar.gz
7z x -y ccextractor-linux-systemlibs-hardsubx-x86_64.tar
mv ccextractor /usr/bin/ccextractor
chmod +x /usr/bin/ccextractor

# N-M3U8DL-Re
cd /temp
url=$(github_latest "nilaoda/N_m3u8DL-RE" "linux-x64.*\\.tar\\.gz")
wget "$url"
filename=$(basename "$url")
tar -xzf "$filename"
mv N_m3u8DL-RE /usr/bin/m3u8
chmod +x /usr/bin/m3u8

# Rclone
cd /temp
curl https://rclone.org/install.sh | bash

# Shaka-Packager
cd /temp
wget https://github.com/shaka-project/shaka-packager/releases/download/v2.6.1/packager-linux-x64
mv packager-linux-x64 /usr/bin/shaka-packager
chmod +x /usr/bin/shaka-packager

# Usque
cd /temp
url=$(github_latest "Diniboy1123/usque" "linux_amd64\\.zip")
wget "$url"
filename=$(basename "$url")
7z x -y "$filename"
mv usque /usr/bin/usque
chmod +x /usr/bin/usque

cd /
rm -rf /temp

apk update
apk upgrade

apk del \
    autoconf automake bash boost-dev ccache clang18-dev cmake curl-dev dpkg g++ gawk gcc gettext-dev jq libtool linux-headers make musl-dev musl-locales nodejs pv unzip xz zip zlib-dev

rm -rf /root/.cache
rm -rf /tmp/*
rm -rf /var/cache/apk/*
rm -rf Dockerfile
rm -rf setup
