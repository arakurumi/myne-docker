#!/bin/sh

apk update
apk upgrade

# Main Packages
apk add --no-cache \
    7zip aria2 coreutils curl fastfetch ffmpeg git libmagic mediainfo mkvtoolnix openjdk25-jre qbittorrent qbittorrent-nox sox tzdata wget

# Build Packages
apk add --no-cache \
    autoconf automake bash boost-dev ccache clang17-dev cmake curl-dev dpkg g++ gawk gcc gettext-dev jq libtool linux-headers make musl-dev musl-locales nodejs pv unzip xz zip

# Python Packages
apk add --no-cache py3-pip python3-dev
python -m pip install --break-system-packages --upgrade pip

mkdir /temp

echo "Asia/Jakarta" >>/etc/timezone
cp /usr/share/zoneinfo/Asia/Jakarta /etc/localtime

# 7Zip
cd /temp
wget https://7-zip.org/a/7z2601-linux-x64.tar.xz
7z x -o7z -y 7z2601-linux-x64.tar.xz
cd /temp/7z
7z x -y 7z2601-linux-x64.tar
mv 7zzs /usr/bin/7z
chmod +x /usr/bin/7z

# Bun
cd /temp
curl -fsSL https://bun.sh/install | bash

# Bento4
cd /temp
mkdir bento4
cd /temp/bento4
git clone -c advice.detachedHead=false https://github.com/axiomatic-systems/Bento4.git .
cmake -DCMAKE_BUILD_TYPE=Release .
make -j$(nproc)
make install

# Code-Server
cd /temp
curl -fsSL https://code-server.dev/install.sh | sh

# Dovi-Tool
cd /temp
wget https://github.com/quietvoid/dovi_tool/releases/latest/download/dovi_tool-2.3.3-x86_64-unknown-linux-musl.tar.gz
7z x -y dovi_tool-2.3.3-x86_64-unknown-linux-musl.tar.gz
7z x -y dovi_tool-2.3.3-x86_64-unknown-linux-musl.tar
mv dovi_tool /usr/bin/dovi_tool
chmod +x /usr/bin/dovi_tool

# Gost
cd /temp
wget https://github.com/ginuerzh/gost/releases/latest/download/gost_2.12.0_linux_amd64v3.tar.gz
7z x -y gost_2.12.0_linux_amd64v3.tar.gz
7z x -y gost_2.12.0_linux_amd64v3.tar
mv gost /usr/bin/gost
chmod +x /usr/bin/gost

# GPAC
cd /temp
mkdir gpac
cd /temp/gpac
git clone -c advice.detachedHead=false https://github.com/gpac/gpac.git .
./configure --static-bin
make -j$(nproc)
make install

# HDR10Plus-Tool
cd /temp
wget https://github.com/quietvoid/hdr10plus_tool/releases/latest/download/hdr10plus_tool-1.7.1-x86_64-unknown-linux-musl.tar.gz
7z x -y hdr10plus_tool-1.7.1-x86_64-unknown-linux-musl.tar.gz
7z x -y hdr10plus_tool-1.7.1-x86_64-unknown-linux-musl.tar
mv hdr10plus_tool /usr/bin/hdr10plus_tool
chmod +x /usr/bin/hdr10plus_tool

# N-M3U8DL-Re
cd /temp
wget https://github.com/nilaoda/N_m3u8DL-RE/releases/latest/download/N_m3u8DL-RE_v0.6.0-beta_linux-x64_20260629.tar.gz
7z x -y N_m3u8DL-RE_v0.6.0-beta_linux-x64_20260629.tar.gz
7z x -y N_m3u8DL-RE_v0.6.0-beta_linux-x64_20260629.tar
mv N_m3u8DL-RE /usr/bin/m3u8
chmod +x /usr/bin/m3u8

# Rclone
cd /temp
curl https://rclone.org/install.sh | bash

# Shaka-Packager
cd /temp
wget https://github.com/shaka-project/shaka-packager/releases/download/v2.6.1/packager-linux-x64
mv packager-linux-x64 /usr/bin/shaka-packager
chmod +x /usr/bin/shaka-packager

# Usque
cd /temp
wget https://github.com/Diniboy1123/usque/releases/latest/download/usque_3.0.0_linux_amd64.zip
7z x -y usque_3.0.0_linux_amd64.zip
mv usque /usr/bin/usque
chmod +x /usr/bin/usque

cd /
rm -rf /temp

apk update
apk upgrade

apk del \
    autoconf automake bash boost-dev ccache clang17-dev cmake curl-dev dpkg g++ gawk gcc gettext-dev jq libtool linux-headers make musl-dev musl-locales nodejs pv unzip xz zip

rm -rf /root/.cache
rm -rf /tmp/*
rm -rf /var/cache/apk/*
rm -rf Dockerfile
rm -rf setup
