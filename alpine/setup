#!/bin/sh
set -e

fetch() {
  curl --fail --location --silent --show-error --retry 5 --retry-delay 2 --retry-connrefused "$@"
}

latest_asset() {
  repo="$1"
  pattern="$2"
  fetch "https://api.github.com/repos/$repo/releases/latest" |
    awk -F'"' -v pat="$pattern" '
      /browser_download_url/ && $4 ~ pat {
        print $4
        exit
      }
    '
}

case "$(uname -m)" in
aarch64 | arm64)
  ccextractor_arch=""
  gost_arch="arm64"
  nm3u8dlre_arch="arm64"
  rclone_arch="arm64"
  rust_triple="aarch64-unknown-linux-musl"
  sevenz_arch="arm64"
  shaka_arch="arm64"
  usque_arch="arm64"
  ;;
x86_64 | amd64)
  ccextractor_arch="x86_64"
  gost_arch="amd64"
  nm3u8dlre_arch="x64"
  rclone_arch="amd64"
  rust_triple="x86_64-unknown-linux-musl"
  sevenz_arch="x64"
  shaka_arch="x64"
  usque_arch="amd64"
  ;;
*)
  echo "Unsupported arch: $(uname -m)"
  exit 1
  ;;
esac

apk update
apk upgrade

# Main Packages
apk add --no-cache \
  aria2 ca-certificates coreutils curl fastfetch ffmpeg file git libffi ncurses-libs readline sqlite-libs libstdc++ mediainfo mkvtoolnix qbittorrent-nox sox tzdata wget

# Build Packages
apk add --no-cache --virtual .build-deps \
  autoconf automake bash boost-dev ccache clang-dev cmake curl-dev dpkg g++ gawk gcc gettext-dev jq libtool linux-headers make musl-dev pv unzip zip zlib-dev

python -m pip install --no-cache-dir --upgrade pip

echo "Asia/Jakarta" >/etc/timezone
cp /usr/share/zoneinfo/Asia/Jakarta /etc/localtime

# 7-Zip
mkdir -p /tmp/7z
cd /tmp/7z
apk add --no-cache --virtual .extract-deps tar xz
sevenz_url=$(latest_asset "ip7z/7zip" "7z[0-9]+-linux-$sevenz_arch\\.tar\\.xz")
sevenz_name="${sevenz_url##*/}"
fetch --output "$sevenz_name" "$sevenz_url"
tar -xf "$sevenz_name"
mv 7zzs /usr/local/bin/7z
chmod +x /usr/local/bin/7z
apk del .extract-deps

# Gost
mkdir -p /tmp/gost
cd /tmp/gost
gost_url=$(latest_asset "ginuerzh/gost" "gost_[0-9]+\\.[0-9]+\\.[0-9]+_linux_$gost_arch\\.tar\\.gz")
gost_name="${gost_url##*/}"
fetch --output "$gost_name" "$gost_url"
7z x "$gost_name"
7z x "${gost_name%.gz}"
mv gost /usr/local/bin/gost
chmod +x /usr/local/bin/gost

# Bento4
git clone -c advice.detachedHead=false https://github.com/axiomatic-systems/Bento4.git /tmp/bento4
cd /tmp/bento4
cmake -DCMAKE_BUILD_TYPE=Release .
make -j$(nproc)
make install

# Code-Server
export npm_config_unsafe_perm=true
fetch https://code-server.dev/install.sh | sh
unset npm_config_unsafe_perm

# Dovi-Tool
mkdir -p /tmp/dovi
cd /tmp/dovi
dovi_url=$(latest_asset "quietvoid/dovi_tool" "$rust_triple\\.tar\\.gz")
dovi_name="${dovi_url##*/}"
fetch --output "$dovi_name" "$dovi_url"
7z x "$dovi_name"
7z x "${dovi_name%.gz}"
mv dovi_tool /usr/local/bin/dovi_tool
chmod +x /usr/local/bin/dovi_tool

# GPAC
git clone -c advice.detachedHead=false https://github.com/gpac/gpac.git /tmp/gpac
cd /tmp/gpac
./configure --static-bin
make -j$(nproc)
make install

# HDR10Plus-Tool
mkdir -p /tmp/hdr10plus
cd /tmp/hdr10plus
hdr_url=$(latest_asset "quietvoid/hdr10plus_tool" "$rust_triple\\.tar\\.gz")
hdr_name="${hdr_url##*/}"
fetch --output "$hdr_name" "$hdr_url"
7z x "$hdr_name"
7z x "${hdr_name%.gz}"
mv hdr10plus_tool /usr/local/bin/hdr10plus_tool
chmod +x /usr/local/bin/hdr10plus_tool

# CCExtractor
if [ -n "$ccextractor_arch" ]; then
  mkdir -p /tmp/ccextractor
  cd /tmp/ccextractor
  fetch --output ccextractor.tar.gz "https://github.com/CCExtractor/ccextractor/releases/latest/download/ccextractor-linux-systemlibs-hardsubx-$ccextractor_arch.tar.gz"
  7z x ccextractor.tar.gz
  7z x ccextractor.tar
  mv ccextractor /usr/local/bin/ccextractor
  chmod +x /usr/local/bin/ccextractor
fi

# N-M3U8DL-RE
mkdir -p /tmp/nm3u8dlre
cd /tmp/nm3u8dlre
nm3u8dlre_url=$(latest_asset "nilaoda/N_m3u8DL-RE" "linux-$nm3u8dlre_arch.*\\.tar\\.gz")
nm3u8dlre_name="${nm3u8dlre_url##*/}"
fetch --output "$nm3u8dlre_name" "$nm3u8dlre_url"
7z x "$nm3u8dlre_name"
7z x "${nm3u8dlre_name%.gz}"
mv N_m3u8DL-RE /usr/local/bin/m3u8
chmod +x /usr/local/bin/m3u8

# Rclone
mkdir -p /tmp/rclone
cd /tmp/rclone
rclone_url=$(latest_asset "rclone/rclone" "rclone-v[0-9]+\\.[0-9]+\\.[0-9]+-linux-$rclone_arch\\.zip")
rclone_name="${rclone_url##*/}"
fetch --output "$rclone_name" "$rclone_url"
7z x "$rclone_name"
mv "/tmp/rclone/${rclone_name%.zip}/rclone" /usr/local/bin/rclone
chmod +x /usr/local/bin/rclone

# Shaka-Packager
mkdir -p /tmp/shaka
cd /tmp/shaka
shaka_url=$(latest_asset "shaka-project/shaka-packager" "packager-linux-$shaka_arch$")
shaka_name="${shaka_url##*/}"
fetch --output "$shaka_name" "$shaka_url"
mv "$shaka_name" /usr/local/bin/shaka-packager
chmod +x /usr/local/bin/shaka-packager

# Usque
mkdir -p /tmp/usque
cd /tmp/usque
usque_url=$(latest_asset "Diniboy1123/usque" "linux_$usque_arch\\.zip")
usque_name="${usque_url##*/}"
fetch --output "$usque_name" "$usque_url"
7z x "$usque_name"
mv usque /usr/local/bin/usque
chmod +x /usr/local/bin/usque

cd /
rm -rf /tmp/*

apk del .build-deps

rm -rf /root/.cache
rm -rf /var/cache/apk/*
rm -rf /var/tmp/*
rm -rf Dockerfile
rm -rf setup
